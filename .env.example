# Copy this file to .env and fill in real values. .env is gitignored.

# Comma-separated list of origins allowed to call the FastAPI backend (CORS).
# Add your deployed site URL in production.
ALLOWED_ORIGINS=http://localhost:3000

# Backend URL the frontend calls (frontend-next).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Public contact email shown on the site, invoices and customer emails.
CONTACT_EMAIL=aimoroinfo@gmail.com
CONTACT_WHATSAPP=+1 242-426-1965
CONTACT_WHATSAPP_2=+1 281-673-6703
PAYMENT_METHODS=PayPal, Zelle or RBC bank transfer
# Customer emails wait as drafts for you to edit and send (set to off to send automatically)
EMAIL_REVIEW=on
EMAIL_SENDER_NAME=Ashley
SOURCING_FEE_HOURLY=25
# Report fee: options stay a blurred preview until you confirm this payment
REPORT_FEE=100
# Optional review link added to the delivered email (otherwise: "reply to this email")
FEEDBACK_URL=
NEXT_PUBLIC_CONTACT_EMAIL=aimoroinfo@gmail.com
NEXT_PUBLIC_CONTACT_WHATSAPP=+1 242-426-1965
NEXT_PUBLIC_CONTACT_WHATSAPP_2=+1 281-673-6703
NEXT_PUBLIC_SITE_URL=https://aimoro.co

# --- Backend ---
# Signs login tokens. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Signing up with one of these emails creates an admin account.
ADMIN_EMAILS=you@example.com
# Leave unset locally to use SQLite (backend/agent.db). Use Postgres in production.
DATABASE_URL=
# Fallback CNY->USD rate if the live rate API is unreachable.
DEFAULT_CNY_USD=0.14
# Public site URL (used for Stripe return links).
SITE_URL=http://localhost:3000
# Optional: enables card payments via Stripe Checkout. Leave unset for bank transfer only.
STRIPE_SECRET_KEY=
BANK_TRANSFER_INSTRUCTIONS=Payment details sent by WhatsApp. Use your invoice number as the payment reference.
# Payment line printed on invoice PDFs.
INVOICE_PAYMENT_NOTE=Payment details sent by WhatsApp.
# Optional: customer emails via resend.com (quote ready, paid, ordered, shipped, delivered).
RESEND_API_KEY=
EMAIL_FROM=AIMORO <orders@yourdomain.com>
