# Copy this file to .env and fill in real values. .env is gitignored.

# Comma-separated list of origins allowed to call the FastAPI backend (CORS).
# Add your deployed site URL in production.
ALLOWED_ORIGINS=http://localhost:3000

# Backend URL the frontend calls (frontend-next).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# --- Backend ---
# Signs login tokens. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Signing up with one of these emails creates an admin account.
ADMIN_EMAILS=you@example.com
# Leave unset locally to use SQLite (backend/agent.db). Use Postgres in production.
DATABASE_URL=
# Fallback CNY->USD rate if the live rate API is unreachable.
DEFAULT_CNY_USD=0.14
# Public site URL (used for Stripe return links).
SITE_URL=http://localhost:3000
# Optional: enables card payments via Stripe Checkout. Leave unset for bank transfer only.
STRIPE_SECRET_KEY=
BANK_TRANSFER_INSTRUCTIONS=Bank transfer details will be sent to you. Use your invoice number as the reference.
# Optional: customer emails via resend.com (quote ready, paid, ordered, shipped, delivered).
RESEND_API_KEY=
EMAIL_FROM=AIMORO <orders@yourdomain.com>
